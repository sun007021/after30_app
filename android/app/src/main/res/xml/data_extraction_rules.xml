<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12(API 31) 이상의 클라우드 백업/기기 간 전송에서 flutter_secure_storage
  (D8, 로그인 토큰 저장소)가 쓰는 SharedPreferences 파일을 제외한다.
  리뷰 M1③: 로그인 토큰이 다른 기기로 그대로 복원되면 앱이 그 토큰으로
  자동 로그인을 시도하다가, Android Keystore 키는 기기별로 생성되므로
  복호화에 실패해 매 요청이 예외를 던지는 상태가 될 수 있다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
